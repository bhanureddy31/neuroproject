# NeuroDiagnosis Public Deployment Environment Variables
# Copy these into your Vercel Project Settings -> Environment Variables

# Optional Remote Python PyTorch Inference Engine URL (e.g. Hugging Face Spaces / Render)
# If omitted, system runs local Python / Docker container inference
PYTHON_INFERENCE_URL=

# Optional Turso Cloud LibSQL Database Credentials
# If omitted, system defaults to local file database
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
